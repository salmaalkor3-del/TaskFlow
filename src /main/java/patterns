================================================ SINGLETON ================================================
package patterns;

import models.User;

/**
 * Singleton Pattern pour le service de notification.
 */
public class NotificationService {
    // L'unique instance du service
    private static NotificationService instance;

    private NotificationService() {}

    public static NotificationService getInstance() {
        if (instance == null) {
            instance = new NotificationService();
        }
        return instance;
    }

    public boolean notifier(User user, String message) {
        System.out.println("Notification pour " + user.getUsername() + " : " + message);
        return true;
    }
}
