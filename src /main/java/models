package models;

import java.util.Date;

public class Task {
    private int id;
    private String titre;
    private String description;
    private Date dateEcheance;
    private TaskStatus statut;

    public Task(int id, String titre, String description, Date dateEcheance) {
        this.id = id;
        this.titre = titre;
        this.description = description;
        this.dateEcheance = dateEcheance;
        this.statut = TaskStatus.A_FAIRE;
    }

    public TaskStatus changerStatut() {
        // Logique pour changer le statut
        return this.statut;
    }

    public boolean assignerUtilisateur() {
        return true;
    }
}
