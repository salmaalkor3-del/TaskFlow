================================================ TaskService ================================================
package services;

import models.Task;
import models.User;
import patterns.NotificationService;
import patterns.TaskFactory;

public class TaskService {

    public Task createTask(String titre, String description) {
        Task task = TaskFactory.createTask(titre, description);
        System.out.println("Tâche créée");
        return task;
    }

    public void assignTask(Task task, User user) {
        task.assignerUtilisateur(user);
        NotificationService service = NotificationService.getInstance();
        service.notifier(user, "Une nouvelle tâche vous a été assignée");
        System.out.println("Tâche assignée");
    }

    public void changeStatus(Task task) {
        task.changerStatut();
        System.out.println("Statut modifié");
    }
}

